{
  "name": "junk-rocket-ruckus",
  "version": "0.1.0",
  "private": true,
  "description": "폐품 로켓 대소동 — 세로형 모바일 물리 장난 게임 (Three.js + planck.js)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "build:test": "VITE_TEST_HOOKS=1 vite build --outDir dist-test",
    "test": "vitest run",
    "test:e2e": "npm run build:test && playwright test",
    "check:font": "python3 scripts/check-font.py",
    "check:release": "node scripts/check-release.mjs",
    "ci": "npm run typecheck && npm test && npm run build && npm run check:release && npm run check:font && npm run test:e2e",
    "docs:parts": "tsx scripts/gen-parts-doc.ts"
  },
  "dependencies": {
    "@fontsource/jua": "^5.3.0",
    "planck": "^1.4.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
